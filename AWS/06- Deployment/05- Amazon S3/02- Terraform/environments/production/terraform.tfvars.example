# AWS account and Region configuration
aws_region         = "ap-south-1"
replica_aws_region = "ap-southeast-1"

# Replace with the 12-digit AWS account ID that owns the source bucket.
source_account_id = "123456789012"

# Replace with globally unique S3 bucket names.
# Use production-specific names and verify availability before deployment.
source_bucket_name  = "your-org-production-s3-source-documents"
replica_bucket_name = "your-org-production-s3-replica-documents"

# Production buckets should not be force-destroyed.
force_destroy = false

# Optional customer-managed KMS key ARNs.
# Configure both keys when using SSE-KMS replication.
# Ensure the replication role is authorized by both KMS key policies.
source_kms_key_arn      = null
destination_kms_key_arn = null

# IAM role assumed by Amazon S3 for replication.
replication_role_name = "production-s3-replication-role"

# Empty prefix selects all eligible objects.
# Set a specific prefix when only part of the source bucket should replicate.
replication_filter_prefix = ""

# Replication configuration
replication_enabled       = true
destination_storage_class = "STANDARD"

# Replication monitoring
replication_metrics_enabled = true

# Replication Time Control can incur additional charges.
# Enable only when the 15-minute replication SLA is required.
replication_time_control_enabled = false
