# Application
APP_NAME=secure-file-upload-api
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Authentication
AUTH_ENABLED=true
SECRET_KEY=replace-with-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:////app/data/secure_upload.db

# AWS Configuration
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
AWS_PROFILE=

# S3 Configuration
S3_BUCKET_NAME=replace-with-your-s3-bucket-name
S3_BUCKET_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_UPLOAD_PREFIX=uploads/

# Upload Validation
S3_MAX_UPLOAD_SIZE_BYTES=10485760
S3_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png

# Presigned URL Configuration
S3_PRESIGNED_URL_EXPIRATION_SECONDS=300

# Server-Side Encryption
# AES256 = SSE-S3
# aws:kms = SSE-KMS
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=

# AWS Credentials
# Prefer IAM roles or the AWS SDK default credential provider chain.
# Leave empty when using IAM roles or an AWS profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Local S3-Compatible Development
# Enable only when intentionally using LocalStack or another compatible endpoint.
USE_LOCALSTACK=false
LOCALSTACK_ENDPOINT_URL=http://localstack:4566

# Logging
JSON_LOGGING=false