# Dummy local configuration for Secure File Upload API.
# Replace these values before running the application against real AWS resources.

# Application
SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=true
ENVIRONMENT=development

# AWS / S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=dummy-access-key
AWS_SECRET_ACCESS_KEY=dummy-secret-key
S3_BUCKET_NAME=dummy-secure-file-upload-bucket

# S3 upload configuration
S3_PRESIGNED_URL_EXPIRATION_SECONDS=300
S3_MAX_UPLOAD_SIZE_BYTES=10485760
