# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Static analysis caches
.mypy_cache/
.ruff_cache/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
Thumbs.db

# Local environment configuration
.env
.env.*
!.env.example

# Project-generated numerical data
data/raw/
data/processed/
data/output/

# Generated reports
reports/generated/

# Temporary files
*.tmp
*.temp
*.log

