# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mongodb_background_worker

# MongoDB client timeouts
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=30000

# MongoDB connection pool
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=5

# Retryable MongoDB operations
MONGODB_RETRY_READS=true
MONGODB_RETRY_WRITES=true

# Background worker
WORKER_NAME=mongodb-background-worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=100
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_SECONDS=5

# MongoDB collections
MONGODB_JOBS_COLLECTION=jobs
MONGODB_RESULTS_COLLECTION=job_results

# Application logging
LOG_LEVEL=INFO

