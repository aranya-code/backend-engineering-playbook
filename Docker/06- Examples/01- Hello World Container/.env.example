# =============================================================================
# .env.example
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These variables are read by app.py via os.getenv().
# Pass them to the container with:
#   docker run --env-file .env hello-docker
# Or individually:
#   docker run -e APP_NAME="My App" hello-docker
# =============================================================================

APP_NAME=Backend Engineering Playbook
