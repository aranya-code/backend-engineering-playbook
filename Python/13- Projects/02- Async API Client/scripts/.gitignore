# Environment and secrets
.env
.env.*
!.env.example

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type-checking and linting caches
.mypy_cache/
.ruff_cache/

# Packaging and build artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db

# Local logs
*.log
logs/

# Runtime output
*.pid

