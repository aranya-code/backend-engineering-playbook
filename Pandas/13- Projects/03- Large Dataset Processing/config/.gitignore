# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment files and local overrides
.env
.env.*
!.env.example
*.local.yaml
*.local.yml
config/local/
config/override/

# Credentials and secrets
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
secrets.yaml
secrets.yml
secrets.json

# Pipeline-generated data
data/raw/*
data/staging/*
data/processed/*
reports/*
benchmarks/*.json
benchmarks/*.csv
benchmarks/*.parquet

# Preserve directory placeholders
!data/raw/.gitkeep
!data/staging/.gitkeep
!data/processed/.gitkeep
!reports/.gitkeep
!benchmarks/.gitkeep

# Temporary and intermediate files
*.tmp
*.temp
*.bak
*.part
*.lock

# Logs
*.log
logs/
log/

# Local databases
*.db
*.sqlite
*.sqlite3

# Jupyter artifacts
.ipynb_checkpoints/

# Profiling and benchmark artifacts
.prof
.profraw
*.lprof

# Generated pipeline outputs
*.json.tmp
*.csv.tmp
*.parquet.tmp
*.checkpoint
*.checkpoint.tmp

# OS metadata
.Trashes/
ehthumbs.db

# Local configuration generated by tooling
config/*.local.yaml
config/*.local.yml
config/*.override.yaml
config/*.override.yml

